  "files": [
    {
      "kind": "folder",
      "path": "UsernameGenerator",
      "target-membership": [
        "UsernameGenerator",
        "UsernameKeyboard",
        "UsernameSafariExtension",
        "UsernameWidgetExtension",
      ],
      "membership-exceptions": [
        {
          "target": "UsernameWidgetExtension",
          "exclusions": [
            "Assets.xcassets",
            "ContentView.swift",
            "GenerateUsernameIntent.swift",
            "UsernameGeneratorApp.swift",
